; Self-authored integer consumers. B70 shares float types and remains floating.
OpCapability Shader
OpCapability SampledBuffer
OpMemoryModel Logical GLSL450
OpEntryPoint Fragment %main "main" %out
OpExecutionMode %main OriginUpperLeft
OpDecorate %indices DescriptorSet 0
OpDecorate %indices Binding 64
OpDecorate %other DescriptorSet 0
OpDecorate %other Binding 70
OpDecorate %out Location 0
%void = OpTypeVoid
%float = OpTypeFloat 32
%uint = OpTypeInt 32 0
%int = OpTypeInt 32 1
%v4 = OpTypeVector %float 4
%image = OpTypeImage %float Buffer 0 0 0 1 Unknown
%sampled = OpTypeSampledImage %image
%pointer = OpTypePointer UniformConstant %sampled
%indices = OpVariable %pointer UniformConstant
%other = OpVariable %pointer UniformConstant
%output = OpTypePointer Output %v4
%out = OpVariable %output Output
%local_float = OpTypePointer Function %float
%zero = OpConstant %int 0
%one = OpConstant %int 1
%fn = OpTypeFunction %void
%main = OpFunction %void None %fn
%label = OpLabel
%temporary = OpVariable %local_float Function
%s = OpLoad %sampled %indices
%i = OpImage %image %s
%a = OpImageFetch %v4 %i %zero None
%b = OpImageFetch %v4 %i %one None
%ax = OpCompositeExtract %float %a 0
%bx = OpCompositeExtract %float %b 0
%index_a = OpBitcast %uint %ax
OpStore %temporary %bx
%loaded_b = OpLoad %float %temporary
%index_b = OpBitcast %int %loaded_b
%numeric_a = OpConvertUToF %float %index_a
%numeric_b = OpConvertSToF %float %index_b
%numeric_sum = OpFAdd %float %numeric_a %numeric_b
%vector_sum = OpCompositeConstruct %v4 %numeric_sum %numeric_sum %numeric_sum %numeric_sum
%other_s = OpLoad %sampled %other
%other_i = OpImage %image %other_s
%other_value = OpImageFetch %v4 %other_i %zero None
%sum = OpFAdd %v4 %vector_sum %other_value
OpStore %out %sum
OpReturn
OpFunctionEnd
