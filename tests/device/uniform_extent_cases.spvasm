; Self-authored regression for a uniform variable ID equal to a constant literal.
OpCapability Shader
%glsl = OpExtInstImport "GLSL.std.450"
OpMemoryModel Logical GLSL450
OpEntryPoint GLCompute %main "main"
OpExecutionMode %main LocalSize 1 1 1
OpDecorate %array ArrayStride 16
OpDecorate %block Block
OpMemberDecorate %block 0 Offset 0
OpDecorate %10 DescriptorSet 0
OpDecorate %10 Binding 1
%void = OpTypeVoid
%function = OpTypeFunction %void
%uint = OpTypeInt 32 0
%float = OpTypeFloat 32
%vec4 = OpTypeVector %float 4
%zero = OpConstant %uint 0
%three = OpConstant %uint 3
%ten = OpConstant %uint 10
%length = OpConstant %uint 4096
%array = OpTypeArray %vec4 %length
%block = OpTypeStruct %array
%block_pointer = OpTypePointer Uniform %block
%vector_pointer = OpTypePointer Uniform %vec4
%10 = OpVariable %block_pointer Uniform
%main = OpFunction %void None %function
%entry = OpLabel
%computed = OpIAdd %uint %zero %three
%element = OpAccessChain %vector_pointer %10 %zero %three
%loaded = OpLoad %vec4 %element
%angle = OpExtInst %vec4 %glsl Fract %loaded
OpReturn
OpFunctionEnd
