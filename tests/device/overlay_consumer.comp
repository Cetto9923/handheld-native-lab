#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, r32ui) uniform uimageBuffer target;
layout(push_constant) uniform Params { uint count; } p;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < p.count) imageStore(target, int(i), uvec4(imageLoad(target, int(i)).x ^ 0xa5a5a5a5u));
}
